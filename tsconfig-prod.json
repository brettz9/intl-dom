{
  "compilerOptions": {
    "lib": ["es2024", "DOM"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "es2024",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.js", "typings/intlDomLocale.d.ts"],
  "exclude": ["node_modules"]
}
