{
  "name": "intl-dom",
  "version": "0.21.0",
  "description": "Internationalization allowing interspersing of DOM elements among the localized strings",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.esm.js",
    "require": "./dist/index.umd.js"
  },
  "scripts": {
    "tsc": "tsc",
    "attw": "attw --profile node16 --pack .",
    "license-badge": "license-badger --corrections --uncategorizedLicenseTemplate \"\\${license} (\\${name} (\\${version}))\" --filteredTypes=nonempty --textTemplate \"License types\n(project, deps, and bundled devDeps)\" --packageJson --production badges/licenses-badge.svg",
    "license-badge-dev": "license-badger --corrections --filteredTypes=nonempty --textTemplate \"License types\n(all devDeps)\" --allDevelopment badges/licenses-badge-dev.svg",
    "license-badges": "pnpm license-badge && pnpm license-badge-dev",
    "prepublishOnly": "echo 'skipping pnpm license-badges for now for time required'",
    "filesize-badge": "filesize-badger --filesizeFormat=\"{}\" --file=\"dist/index.umd.js\" badges/filesize-badge.svg",
    "eslint": "eslint .",
    "lint": "pnpm eslint",
    "build": "pnpm rollup && tsc -p tsconfig-prod.json",
    "rollup": "rollup -c",
    "find-matching-locale": "node server.js",
    "intl-mocha": "node --icu-data-dir=node_modules/full-icu node_modules/mocha/bin/mocha",
    "coverage-badge": "coveradge badges/coverage-badge.svg",
    "mocha": "mocha",
    "open-coverage": "pnpm c8 && open-cli http://localhost:8010/coverage/ && npm start",
    "c8": "echo 'Removing esm cache which seems to blank out istanbul coverage when breaking out early' && rm -Rf node_modules/.cache/esm && c8 pnpm mocha && pnpm coverage-badge",
    "browserify": "pnpm browserify-displaynames && pnpm browserify-datetimeformat",
    "browserify-datetimeformat": "browserify --entry node_modules/@formatjs/intl-datetimeformat/polyfill.js --standalone DateTimeFormat --outfile ./test/browser/vendor/formatjs-intl-datetimeformat-polyfill.js",
    "browserify-displaynames": "browserify --entry node_modules/@formatjs/intl-displaynames/polyfill.js --standalone DisplayNames --outfile ./test/browser/vendor/formatjs-intl-displaynames-polyfill.js",
    "open": "open-cli http://localhost:8010/test/browser/ && npm start",
    "start": "static -p 8010",
    "test-nocov": "pnpm eslint && pnpm build && pnpm mocha",
    "test": "pnpm eslint && pnpm build && pnpm c8"
  },
  "browserslist": [
    "cover 100%"
  ],
  "c8": {
    "reporter": [
      "html",
      "text",
      "json-summary"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettz9/intl-dom.git"
  },
  "keywords": [
    "i18n",
    "l10n"
  ],
  "author": "Brett Zamir",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brettz9/intl-dom/issues"
  },
  "homepage": "https://github.com/brettz9/intl-dom#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "file-fetch": "1.6.1",
    "json-6": "^1.1.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@brettz9/node-static": "^0.1.1",
    "@fintechstudios/eslint-plugin-chai-as-promised": "^3.1.0",
    "@formatjs/intl-datetimeformat": "^7.6.0",
    "@formatjs/intl-displaynames": "^7.3.13",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/chai-dom": "^1.11.3",
    "@types/file-fetch": "^1.6.6",
    "@types/jsdom": "^28.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node-fetch": "^2.6.13",
    "browserify": "^17.0.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "chai-dom": "^1.12.1",
    "coveradge": "^0.8.2",
    "eslint": "^10.8.0",
    "eslint-config-ash-nazg": "^42.1.0",
    "filesize-badger": "^0.4.0",
    "full-icu": "^1.6.0",
    "intl-list-format": "^1.0.3",
    "intl-pluralrules": "^2.0.1",
    "intl-relative-time-format": "^1.0.7",
    "jsdom": "^30.0.1",
    "json5": "^2.2.3",
    "license-badger": "^0.23.0",
    "mocha": "^11.8.0",
    "mocha-badge-generator": "^0.11.0",
    "mocha-multi-reporters": "^1.5.1",
    "node-fetch": "^3.3.2",
    "open-cli": "^9.0.0",
    "rollup": "^4.62.4",
    "typescript": "^7.0.2"
  }
}
